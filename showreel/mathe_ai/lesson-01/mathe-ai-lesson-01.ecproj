                        "text": "var s=\"επαλήθευση: 2·6 + 5 = 17\";var n=Math.max(0,Math.min(s.length,Math.floor((time-2.34375)*60)));var o=s.slice(0,n);var c=\"\";if(time<2.34375)c=\"\";var st=text.sourceText.style.setText(o+c);var R=[[12,12,[0.9725490196078431,0.8666666666666667,0.24705882352941178]]];for(var i=0;i<R.length;i++){if(R[i][0]<o.length)st=st.setFillColor(R[i][2],R[i][0],Math.min(R[i][1],o.length-R[i][0]));}st",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Text"
                      },

                      "expr": {
                        "text": "var s=\"εξήγησέ μου βήμα-βήμα πώς λύνω την εξίσωση 2x + 5 = 17. είμαι στη Β΄ λυκείου. μη μου πεις μόνο την απάντηση.\";var n=Math.max(0,Math.min(s.length,Math.floor((time-0.32)*60)));var o=s.slice(0,n);var c=\"\\u258c\";if(n>=s.length&&Math.floor((time-0.32)/0.234375)%2==1)c=\" \";if(time<0.32)c=\"\";var st=text.sourceText.style.setText(o+c);if(c.length&&c!=\" \")st=st.setFillColor([1,0.29411764705882354,0.12156862745098039],o.length,1);st",
                        "enabled": true
                      },

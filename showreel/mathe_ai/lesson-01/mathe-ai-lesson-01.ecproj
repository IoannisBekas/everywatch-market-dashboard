                        "text": "var s=\"είμαι στη Β΄ λυκείου και γράφω διαγώνισμα την Παρασκευή\";var n=Math.max(0,Math.min(s.length,Math.floor((time-0.56875)*45)));var o=s.slice(0,n);var c=\"\\u258c\";if(n>=s.length&&Math.floor((time-0.56875)/0.234375)%2==1)c=\" \";if(time<0.56875)c=\"\";var st=text.sourceText.style.setText(o+c);if(c.length&&c!=\" \")st=st.setFillColor([1,0.29411764705882354,0.12156862745098039],o.length,1);st",
                        "enabled": true

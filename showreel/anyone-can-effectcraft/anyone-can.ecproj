                      "expr": {
                        "text": "var s=\"make a 20-second motion graphics video in EffectCraft that shows what an incredible motion designer you are, like it's your showreel. go all out.\";var n=Math.max(0,Math.min(s.length,Math.floor((time-0.3)*66)));var o=s.slice(0,n);var c=\"\\u258c\";if(n>=s.length&&Math.floor((time-0.3)/0.22727272727272727)%2==1)c=\" \";if(time<0.3)c=\"\";var st=text.sourceText.style.setText(o+c);if(c.length&&c!=\" \")st=st.setFillColor([0.9372549019607843,0.30196078431372547,0.22745098039215686],o.length,1);st",
                        "enabled": true
                      },
                      "ui": {
                        "kind": "Text"
